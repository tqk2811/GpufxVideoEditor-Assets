{
  "id": "letter_spin",
  "name": "Letters spin in",
  "kind": "in",
  "default_duration": 1.0,
  "applies_to": ["text"],
  "per_unit": {
    "unit": "char",
    "stagger": 0.6,
    "curve": {
      "tracks": {
        "rotation": [
          { "t": 0, "value": -360, "ease": "outCubic" },
          { "t": 1, "value": 0 }
        ],
        "scale": [
          { "t": 0, "value": 0.3, "ease": "outCubic" },
          { "t": 1, "value": 1 }
        ],
        "opacity": [
          { "t": 0, "value": 0 },
          { "t": 0.3, "value": 1 }
        ]
      }
    }
  }
}
