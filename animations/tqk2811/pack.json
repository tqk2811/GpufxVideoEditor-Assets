        "tracks": {
          "dx": [
            { "t": 0, "value": -0.494, "ease": "outCubic" },
            { "t": 0.45, "value": -0.269 },
            { "t": 0.75, "value": -0.131, "ease": "inOutSine" },
            { "t": 1, "value": 0 }
