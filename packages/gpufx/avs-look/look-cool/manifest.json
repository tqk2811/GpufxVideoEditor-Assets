{
  "api": 1,
  "id": "io.github.tqk2811.avs.look-cool",
  "name": "Cool Look",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Color look: saturate(1.05) hue-rotate(12deg) brightness(1.02).",
