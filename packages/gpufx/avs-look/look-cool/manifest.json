      "min": 0,
      "max": 1,
      "description": "Strength: 0 is the original picture, 1 the look"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/look.wgsl"
        }
      ]
    }
  ]
}
