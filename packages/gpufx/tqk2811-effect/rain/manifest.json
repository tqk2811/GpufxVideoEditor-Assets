{
  "api": 1,
  "id": "io.github.tqk2811.rain",
  "name": "Rain",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Rain: thin slanted streaks fall fast over a slightly darker picture.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "density",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "description": "Part of the grid cells that hold a particle"
    },
    {
      "name": "speed",
      "type": "float",
      "default": 1.8,
      "min": -3,
      "max": 5,
      "description": "Speed, frame heights per second"
    },
    {
      "name": "wind",
      "type": "float",
      "default": 0.0,
      "min": -2,
      "max": 2,
      "description": "Sideways drift, frame heights per second (negative blows left)"
    },
    {
      "name": "size",
      "type": "float",
      "default": 1.0,
      "min": 0.2,
      "max": 4,
      "description": "Particle size; larger particles are also fewer"
    },
    {
      "name": "opacity",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Opacity of the particles"
    },
    {
      "name": "angle",
      "type": "float",
      "default": 12,
      "min": -60,
      "max": 60,
      "description": "Slant of the rain in degrees (positive falls to the right)"
    },
    {
      "name": "dim",
      "type": "float",
      "default": 0.15,
      "min": 0,
      "max": 1,
      "description": "Darkens the picture under the rain"
    },
    {
      "name": "color",
      "type": "color",
      "default": "#c8d6e6",
      "description": "Rain color"
    },
    {
      "name": "seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 100000,
      "description": "Changes where the particles are"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/rain.wgsl"
        }
      ]
    }
  ]
}
