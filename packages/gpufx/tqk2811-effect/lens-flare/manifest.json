{
  "api": 1,
  "id": "io.github.tqk2811.lens-flare",
  "name": "Lens Flare",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Lens flare: a bright light source with a glow, a streak, rays and colored ghosts across the frame.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.3,
        0.25
      ],
      "min": -0.5,
      "max": 1.5,
      "description": "Position of the light, 0..1 of the frame ([0, 0] = top-left)"
    },
    {
      "name": "intensity",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 3,
      "description": "Brightness of the flare"
    },
    {
      "name": "ghosts",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 2,
      "description": "Strength of the colored ghosts"
    },
    {
      "name": "streak",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 2,
      "description": "Strength of the horizontal streak"
    },
    {
      "name": "color",
      "type": "color",
      "default": "#ffe2b8",
      "description": "Color of the light"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/lens_flare.wgsl"
        }
      ]
    }
  ]
}
