{
  "api": 1,
  "id": "io.github.tqk2811.dust-scratches",
  "name": "Dust & Scratches",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Dust specks, hairs and vertical scratches that jump around from frame to frame, as on a worn film print.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "dust",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Amount of dust specks"
    },
    {
      "name": "scratches",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Amount of vertical scratches"
    },
    {
      "name": "opacity",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "description": "Visibility of the marks"
    },
    {
      "name": "fps",
      "type": "float",
      "default": 12,
      "min": 1,
      "max": 60,
      "description": "How often the marks jump"
    },
    {
      "name": "color",
      "type": "color",
      "default": "#1a1612",
      "description": "Color of the marks (light colors give white dust)"
    },
    {
      "name": "seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 100000,
      "description": "Changes the pattern"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/dust_scratches.wgsl"
        }
      ]
    }
  ]
}
