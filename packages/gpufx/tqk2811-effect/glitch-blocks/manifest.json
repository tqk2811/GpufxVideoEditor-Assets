{
  "api": 1,
  "id": "io.github.tqk2811.glitch-blocks",
  "name": "Glitch Blocks",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Digital glitch: blocks of the picture jump sideways, split their colors or freeze into flat color for a few frames at a time.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "amount",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "How many blocks glitch"
    },
    {
      "name": "shift",
      "type": "float",
      "default": 0.06,
      "min": 0,
      "max": 0.3,
      "description": "Largest sideways jump, part of the frame width"
    },
    {
      "name": "block",
      "type": "float",
      "default": 0.08,
      "min": 0.01,
      "max": 0.5,
      "description": "Block height, part of the frame height"
    },
    {
      "name": "rate",
      "type": "float",
      "default": 8,
      "min": 0.5,
      "max": 30,
      "description": "Glitch changes per second"
    },
    {
      "name": "bursts",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Part of the time that glitches (0 = never, 1 = always)"
    },
    {
      "name": "seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 100000,
      "description": "Changes the pattern"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/glitch_blocks.wgsl"
        }
      ]
    }
  ]
}
