{
  "api": 1,
  "id": "io.github.tqk2811.vhs",
  "name": "VHS",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "VHS tape: color fringes, wobbling lines, a rolling tracking band, noise and scanlines.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "wobble",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 4,
      "description": "Sideways wobble of the lines"
    },
    {
      "name": "chroma",
      "type": "float",
      "default": 0.004,
      "min": 0,
      "max": 0.03,
      "description": "Red/blue fringe offset, part of the frame width"
    },
    {
      "name": "tracking",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "description": "Strength of the rolling tracking band"
    },
    {
      "name": "noise",
      "type": "float",
      "default": 0.05,
      "min": 0,
      "max": 0.5,
      "description": "Static noise"
    },
    {
      "name": "scanlines",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Darkening of every other line"
    },
    {
      "name": "saturation",
      "type": "float",
      "default": 0.85,
      "min": 0,
      "max": 2,
      "description": "Color saturation"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/vhs.wgsl"
        }
      ]
    }
  ]
}
