{
  "api": 1,
  "id": "io.github.tqk2811.smoke",
  "name": "Smoke",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Smoke: soft wisps rise from the bottom of the frame, curl and thin out as they climb.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "density",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "description": "Thickness of the smoke"
    },
    {
      "name": "speed",
      "type": "float",
      "default": 0.08,
      "min": -1,
      "max": 1,
      "description": "Rising speed, frame heights per second"
    },
    {
      "name": "scale",
      "type": "float",
      "default": 1.0,
      "min": 0.2,
      "max": 4,
      "description": "Size of the wisps"
    },
    {
      "name": "height",
      "type": "float",
      "default": 0.7,
      "min": 0.05,
      "max": 1,
      "description": "How high the smoke climbs before it fades"
    },
    {
      "name": "curl",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 3,
      "description": "How much the wisps twist"
    },
    {
      "name": "color",
      "type": "color",
      "default": "#b8b8bc",
      "description": "Smoke color"
    },
    {
      "name": "seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 100000,
      "description": "Changes the wisps"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/smoke.wgsl"
        }
      ]
    }
  ]
}
