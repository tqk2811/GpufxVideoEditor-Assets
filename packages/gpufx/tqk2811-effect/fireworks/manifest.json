{
  "api": 1,
  "id": "io.github.tqk2811.fireworks",
  "name": "Fireworks",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Fireworks: rockets burst into rings of falling, fading sparks across the sky.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "rate",
      "type": "float",
      "default": 1.2,
      "min": 0.1,
      "max": 6,
      "description": "Bursts per second"
    },
    {
      "name": "size",
      "type": "float",
      "default": 0.25,
      "min": 0.05,
      "max": 0.6,
      "description": "Burst radius, part of the frame height"
    },
    {
      "name": "brightness",
      "type": "float",
      "default": 1.6,
      "min": 0,
      "max": 3,
      "description": "Brightness of the sparks"
    },
    {
      "name": "height",
      "type": "float",
      "default": 0.55,
      "min": 0.1,
      "max": 1,
      "description": "Lowest burst position, 0 = top, 1 = bottom"
    },
    {
      "name": "seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 100000,
      "description": "Changes the bursts and colors"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/fireworks.wgsl"
        }
      ]
    }
  ]
}
