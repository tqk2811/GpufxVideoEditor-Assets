{
  "api": 1,
  "id": "io.github.tqk2811.teal-orange",
  "name": "Teal & Orange",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Teal and orange grade: shadows lean to teal, skin tones and highlights to orange.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "Strength: 0 is the original picture, 1 the full effect"
    },
    {
      "name": "strength",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1.5,
      "description": "How far the colors are pushed"
    },
    {
      "name": "shadow",
      "type": "color",
      "default": "#0f7c8c",
      "description": "Color the shadows lean to"
    },
    {
      "name": "highlight",
      "type": "color",
      "default": "#ff9a4a",
      "description": "Color the highlights lean to"
    },
    {
      "name": "contrast",
      "type": "float",
      "default": 1.1,
      "min": 0.5,
      "max": 2,
      "description": "Contrast around middle gray"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/teal_orange.wgsl"
        }
      ]
    }
  ]
}
