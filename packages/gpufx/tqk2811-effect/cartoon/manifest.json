{
  "api": 1,
  "id": "io.github.tqk2811.cartoon",
  "name": "Cartoon",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Cartoon: flat bands of color with dark ink outlines.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "levels",
      "type": "int",
      "default": 6,
      "min": 2,
      "max": 16,
      "description": "Number of brightness bands"
    },
    {
      "name": "saturation",
      "type": "float",
      "default": 1.25,
      "min": 0,
      "max": 3,
      "description": "Color saturation"
    },
    {
      "name": "edge",
      "type": "float",
      "default": 0.2,
      "min": 0.01,
      "max": 1,
      "description": "Edge threshold: lower draws more lines"
    },
    {
      "name": "edge_width",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 4,
      "description": "Line width in pixels"
    },
    {
      "name": "edge_color",
      "type": "color",
      "default": "#101010",
      "description": "Line color"
    },
    {
      "name": "amount",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "Strength: 0 is the original picture, 1 the full effect"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/cartoon.wgsl"
        }
      ]
    }
  ]
}
