{
  "api": 1,
  "id": "io.github.tqk2811.avs.grid-pixelate-wipe",
  "name": "Grid Pixelate Wipe",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A grid of cells covers the first clip and opens onto the second.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "cols",
      "type": "int",
      "default": 16,
      "min": 1,
      "max": 64,
      "description": "Columns"
    },
    {
      "name": "rows",
      "type": "int",
      "default": 9,
      "min": 1,
      "max": 64,
      "description": "Rows"
    },
    {
      "name": "color",
      "type": "color",
      "default": "#000000",
      "description": "Cell color"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/transition.wgsl"
        }
      ]
    }
  ]
}
