{
  "api": 1,
  "id": "io.github.tqk2811.avs.whip-pan-cut",
  "name": "Whip Pan Cut",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Both clips sit side by side and whip across the frame with a horizontal blur.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "direction",
      "type": "enum",
      "values": [
        "left",
        "right"
      ],
      "default": "left",
      "description": "Direction of the pan"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#22c55e",
      "description": "Color of the seam between the clips"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/transition.wgsl"
        }
      ]
    }
  ]
}
