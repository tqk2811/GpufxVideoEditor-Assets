{
  "api": 1,
  "id": "io.github.tqk2811.avs.halftone-dissolve",
  "name": "Halftone Dissolve",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Dots of the second clip grow across the first, led by accent colored ink.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "direction",
      "type": "enum",
      "values": [
        "ltr",
        "center",
        "noise"
      ],
      "default": "ltr",
      "description": "How the dots are ordered"
    },
    {
      "name": "dot_size",
      "type": "enum",
      "values": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "description": "Size of the dots"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#71f5a7",
      "description": "Ink color"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/transition.wgsl"
        }
      ]
    }
  ]
}
